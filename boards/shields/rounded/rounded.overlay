
/ {
	chosen {
		zephyr,display = &gc9a01a;
	};
};

&spi1 {
    compatible = "nordic,nrf-spi";
    status = "okay";
    sck-pin = <13>;     /* SCL */
    mosi-pin = <15>;    /* SDA */
    miso-pin = <14>;    /* unused */

    gc9a01a: display@0 {
        compatible = "sitronix,gc9a01a";
        reg = <0>;
        spi-max-frequency = <8000000>;
        label = "GC9A01";
        width = <240>;
        height = <240>;
        rotation = <0>;
        pixel-format = "rgb565";

        cs-gpios        = <&gpio0 12 GPIO_ACTIVE_LOW>;   /* CS */
        cmd-data-gpios  = <&gpio0 11 GPIO_ACTIVE_HIGH>;  /* DC */
        reset-gpios     = <&gpio0 10 GPIO_ACTIVE_LOW>;   /* RES */
        backlight-gpios = <&gpio0  2 GPIO_ACTIVE_HIGH>;  /* BLK */
    };
};
