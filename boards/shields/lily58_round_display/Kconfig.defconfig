# boards/shields/lily58_round_display/Kconfig.defconfig

if SHIELD_LILY58_ROUND_DISPLAY

config ZMK_KEYBOARD_NAME
    default "Lily58 Round"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT
    default y

if ZMK_DISPLAY

choice ZMK_DISPLAY_WORK_QUEUE
    default ZMK_DISPLAY_WORK_QUEUE_DEDICATED
endchoice

endif # ZMK_DISPLAY

if LVGL

config LV_Z_VDB_SIZE
    default 64

config LV_Z_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 16

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_16
endchoice

endif # LVGL

endif # SHIELD_LILY58_ROUND_DISPLAY